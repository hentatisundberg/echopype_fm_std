# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Test, coverage, and lint caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.mypy_cache/
.pyre/

# Build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store

# Local survey inputs and navigation databases
# Keep these out of version control because they can be large,
# proprietary, or survey-specific.
data/raw/*
data/positions/*
*.db
*.sqlite
*.sqlite3

# Generated processing outputs
output/*

# Echopype and temporary processing artifacts
*.zarr/
*.zarr.zip
*.swp
*.tmp
*.log

# Local editor and tool settings
.vscode/
.idea/
